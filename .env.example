# Variables de entorno de 3B (monorepo). Copiá a `.env` y completá.

# Base de datos local (Docker Compose: ver docker-compose.yml).
# OWNER (`3b`): solo para migraciones Drizzle y administración.
DATABASE_URL="postgresql://3b:3b@localhost:5433/3b"
# APP (`app`, mínimo privilegio): runtime de la app, sujeto a RLS.
APP_DATABASE_URL="postgresql://app:app@localhost:5433/3b"

# API local (Hono).
API_PORT=8787

# URL de la API que consume la web (apps/web).
NEXT_PUBLIC_API_URL="http://localhost:8787"
# Origen del web (trustedOrigins de Better Auth).
WEB_URL="http://localhost:3000"

# Better Auth (en dev hay defaults; en prod definir un secret real y largo).
BETTER_AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:8787"
# Google OAuth (opcional; el desarrollo no depende de esto).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
