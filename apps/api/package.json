{
  "name": "@3b/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API de 3B (Hono). Monta los routers http de los módulos de @3b/core.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@3b/auth": "workspace:*",
    "@3b/config": "workspace:*",
    "@3b/contracts": "workspace:*",
    "@3b/core": "workspace:*",
    "@3b/db": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.2.0",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.14",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
