{
  "name": "3b",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "3B — monorepo (apps + packages). Marketplace comunitario.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "boundaries": "depcruise apps packages/core packages/db packages/contracts packages/api-client --config packages/config/dependency-cruiser.cjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run boundaries",
    "storybook": "pnpm --filter @3b/ui storybook",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "pnpm --filter @3b/db migrate",
    "db:seed": "pnpm --filter @3b/db seed",
    "db:reset": "pnpm --filter @3b/db reset && pnpm --filter @3b/auth seed",
    "test:integration": "pnpm db:reset && pnpm -r test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
